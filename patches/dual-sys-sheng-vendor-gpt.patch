diff --git a/scripts/dual_sys/f2fs-shrink.c b/scripts/dual_sys/f2fs-shrink.c
index 317bf60..4295aaa 100644
--- a/scripts/dual_sys/f2fs-shrink.c
+++ b/scripts/dual_sys/f2fs-shrink.c
@@ -28,6 +28,13 @@
 #define F2FS_MAGIC 0xf2f52010U
 #define F2FS_IOC_RESIZE_FS _IOW(0xf5, 16, uint64_t)
 #define BLOCK_BYTES UINT64_C(4096)
+#define SUPER_BYTES 3072
+/* Packed field 0x684 (256 bytes) records the release of the kernel that last
+   mounted the filesystem. Each superblock copy keeps the release of whichever
+   kernel wrote it (sheng: 5.15.144 TWRP vs 5.15.195 MorizukiNeko), so compare
+   the copies with this stamp masked out. */
+#define KERNEL_STAMP_OFFSET 0x684
+#define KERNEL_STAMP_BYTES 256
 #endif
 #define SEG_BLOCKS UINT64_C(512)
 
@@ -77,14 +84,23 @@ static uint64_t super_blocks(int fd)
     const unsigned char *s = copies[0] + 1024;
     const unsigned char *t = copies[1] + 1024;
     /* shortcut: single-device, one segment per section; review other layouts before extending. */
-    if (memcmp(s, t, 3072) || le32(s) != F2FS_MAGIC || le32(s + 16) != 12 ||
-        le32(s + 20) != 9 || le32(s + 24) != 1 ||
-        le32(s + 8) + le32(s + 12) != 12 ||
-        le32(s + 8) < 9 || le32(s + 8) > 12)
+    for (unsigned i = 0; i < 2; i++) {
+        const unsigned char *c = copies[i] + 1024;
+        if (le32(c) != F2FS_MAGIC || le32(c + 16) != 12 || le32(c + 20) != 9 ||
+            le32(c + 24) != 1 || le32(c + 8) + le32(c + 12) != 12 ||
+            le32(c + 8) < 9 || le32(c + 8) > 12)
+            fail("unsupported F2FS geometry or disagreeing superblocks");
+        /* devs[0].path begins at byte 2201 in the packed F2FS superblock. */
+        if (c[2201] || (le32(c + 2180) & 2))
+            fail("multi-device or zoned F2FS is unsupported");
+    }
+    unsigned char masked[2][SUPER_BYTES];
+    memcpy(masked[0], s, SUPER_BYTES);
+    memcpy(masked[1], t, SUPER_BYTES);
+    memset(masked[0] + KERNEL_STAMP_OFFSET, 0, KERNEL_STAMP_BYTES);
+    memset(masked[1] + KERNEL_STAMP_OFFSET, 0, KERNEL_STAMP_BYTES);
+    if (memcmp(masked[0], masked[1], SUPER_BYTES))
         fail("unsupported F2FS geometry or disagreeing superblocks");
-    /* devs[0].path begins at byte 2201 in the packed F2FS superblock. */
-    if (s[2201] || (le32(s + 2180) & 2))
-        fail("multi-device or zoned F2FS is unsupported");
     return le64(s + 36);
 }
 
diff --git a/scripts/dual_sys/gpt.py b/scripts/dual_sys/gpt.py
index aaf876f..aa3f0fa 100644
--- a/scripts/dual_sys/gpt.py
+++ b/scripts/dual_sys/gpt.py
@@ -36,7 +36,15 @@ def header(data, sector, lba, total):
     require(width == 128 and 1 <= count <= 4096, 'unsupported GPT entry geometry')
     # GPT reserves at least 16 KiB even when the header declares fewer entries.
     blocks = (max(16384, count * width) + sector - 1) // sector
-    require(table == (2 if lba == 1 else total - 1 - blocks), 'non-contiguous GPT tables are unsupported')
+    if lba == 1:
+        require(table == 2, 'non-contiguous GPT tables are unsupported')
+    else:
+        # Xiaomi sheng places the backup entry array short of the standard
+        # position (LBA 64007161, 4096-byte sectors) while the header still
+        # lives in the last sector. Follow the header as long as the array
+        # stays after the usable range and before the backup header; a
+        # standard layout (table == total - 1 - blocks) still passes.
+        require(last < table <= total - 1 - blocks, 'non-contiguous GPT tables are unsupported')
     require(2 + blocks <= first <= last < total - 1 - blocks, 'GPT usable range overlaps metadata')
     require(guid != bytes(16), 'missing GPT disk GUID')
     return dict(first=first, last=last, guid=guid, table=table, count=count, blocks=blocks, crc=table_crc)
@@ -46,7 +54,11 @@ def read_gpt(read, sector, total):
     """read(lba, count) returns exact raw logical sectors, without shell output."""
     h = header(read(1, 1), sector, 1, total)
     primary = read(0, 2 + h['blocks'])
-    backup = read(total - 1 - h['blocks'], 1 + h['blocks'])
+    backup_head = read(total - 1, 1)
+    b = header(backup_head, sector, total - 1, total)
+    # The logical backup region is the declared entry array followed by the
+    # header, wherever the vendor placed the array.
+    backup = read(b['table'], h['blocks']) + backup_head
     return GPT(primary, backup, sector, total)
 
 
@@ -56,6 +68,7 @@ class GPT:
         self.primary, self.backup = primary, backup
         h = header(primary[sector:2 * sector], sector, 1, total)
         b = header(backup[-sector:], sector, total - 1, total)
+        self.bh = b
         require(len(primary) == (2 + h['blocks']) * sector and
                 len(backup) == (1 + h['blocks']) * sector, 'short GPT regions')
         require(all(h[k] == b[k] for k in ('first', 'last', 'guid', 'count', 'blocks', 'crc')),
@@ -116,6 +129,7 @@ class GPT:
         return bytes(primary), bytes(backup), dict(
             userdata_index=userdata_index, unixnu_index=empty, userdata_start=user['start'],
             userdata_end=start - 1, unixnu_start=start, unixnu_end=end,
+            backup_table_lba=self.bh['table'], backup_header_lba=self.total - 1,
             old_userdata_bytes=(user['end'] - user['start'] + 1) * self.sector,
             new_userdata_bytes=(start - user['start']) * self.sector,
             unixnu_bytes=requested, tail_gap_bytes=(user['end'] - end) * self.sector)
